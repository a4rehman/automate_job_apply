# ==========================================
# AI Job Application Automation Agent
# Environment Configuration
# ==========================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Environment & Security -------------------------------------------------
ENVIRONMENT=production
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-strong-random-secret-key-32-chars-min
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
APP_PASSWORD=AdminSecurePass123!
# Or provide a pre-hashed bcrypt password instead of APP_PASSWORD:
# APP_PASSWORD_HASH=$2b$12$...

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Use the Supabase "Connection Pooler" (port 6543) string for the serverless
# runtime, or the Session Pooler (port 5432). Never commit the real password.
# A plain postgresql:// URL is automatically converted to postgresql+asyncpg://.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# TLS posture for Postgres: require | verify-full | disable
DB_SSL_MODE=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Local development (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./job_automation.db

# Legacy TiDB (only if you deploy there instead of Supabase):
# TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=
# TIDB_PASSWORD=
# TIDB_DATABASE=automate_job_apply
# TIDB_CA_PATH=

# --- AI Engine (Google Gemini) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# When no API key is set, a deterministic offline evaluator runs instead.
# It scores only measurable signals and never fabricates a high match.
USE_MOCK_AI_FALLBACK=True
AI_PROVIDER=gemini

# Optional legacy OpenAI-compatible configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Automation & Safety Pipeline -------------------------------------------
# SAFE_MODE | ASSISTED_MODE | AUTHORIZED_AUTO_MODE
EXECUTION_MODE=SAFE_MODE
# MASTER SWITCH. Keep false. While false, no real submission can ever occur
# even if --live is passed to the worker.
AUTO_SUBMIT_ENABLED=false
# Keep true so every application requires explicit human approval.
REQUIRE_HUMAN_APPROVAL=true
# Keep true until live execution has been verified end-to-end.
DRY_RUN=true
DEFAULT_MIN_MATCH_SCORE=85.0
DEFAULT_HIGH_MATCH_THRESHOLD=90.0
MIN_MATCH_SCORE=85
MAX_APPLICATIONS_PER_DAY=30
MAX_APPLICATIONS_PER_RUN=10
COOLDOWN_SECONDS=3600
MAX_RETRIES=3
AUTOMATION_TIMEZONE=Asia/Karachi
SCHEDULER_LOCK_TIMEOUT_SECONDS=3600

# --- Email & Notifications (SMTP) -------------------------------------------
# Use a Gmail/Outlook App Password, never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Automation Agent <your-email@gmail.com>
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL=candidate-alerts@example.com

# --- Telegram Notifications (Optional) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Seed Control ------------------------------------------------------------
SEED_DEMO_DATA=false
