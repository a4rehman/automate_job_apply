# ==========================================
# AI Job Application Automation Agent
# Environment Configuration
# ==========================================

# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-strong-random-secret-key
FERNET_KEY=

# Database
# SQLite for local dev (default)
DATABASE_URL=sqlite+aiosqlite:///./job_automation.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_agent_db

# Redis (optional, for Celery/caching)
REDIS_URL=redis://localhost:6379/0

# AI Engine
# Set your API key to enable live LLM analysis
# Supports: OpenAI, OpenRouter, local Ollama/vLLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to True to use built-in offline AI fallback (no API key required)
USE_MOCK_AI_FALLBACK=True

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@jobautomation.local

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Automation Defaults
DEFAULT_MONITOR_INTERVAL_MINUTES=10
DEFAULT_MIN_MATCH_SCORE=75
DEFAULT_HIGH_MATCH_THRESHOLD=90
