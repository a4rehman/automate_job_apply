# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development or enter these in Streamlit Cloud Secrets.
# DO NOT commit real passwords, keys, or hashes to git.

# Application Password Hash (bcrypt hash for secure Streamlit login gate)
# Example generated with bcrypt: $2b$12$...
APP_PASSWORD_HASH = "$2b$12$e8YlI8zLgA5b0w9p9Z9Q.OU2yP3W4B5V6C7D8E9F0G1H2I3J4K5L6"

# Database Configuration (TiDB Cloud MySQL Serverless / Dedicated)
DATABASE_URL = "mysql+aiomysql://<user>.<prefix>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/job_automation?ssl_verify_cert=true"
TIDB_HOST = "gateway01.us-east-1.prod.aws.tidbcloud.com"
TIDB_PORT = 4000
TIDB_USER = "<username>"
TIDB_PASSWORD = "<password>"
TIDB_DATABASE = "job_automation"

# Google Gemini API Configuration
GEMINI_API_KEY = "AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL = "gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL = "text-embedding-004"

# Notification & SMTP Configuration
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@gmail.com"
SMTP_PASSWORD = "your-app-password"
SMTP_FROM = "alerts@jobautomation.local"
NOTIFICATION_EMAIL_TO = "your-personal-email@gmail.com"

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
